# Leave unset to use the Vite dev proxy at /engine-api
# The proxy host/port default to the values defined in ../stock-index-engine/settings.json (`"api.host"`, `"api.port"`)
# Set to an absolute URL (e.g. https://your-domain/api) for production deployments
# VITE_ENGINE_API_BASE_URL=http://localhost:8000

# Optional: override the dev proxy target (defaults to the settings.json host/port)
# VITE_DEV_ENGINE_PROXY_TARGET=http://localhost:8000
